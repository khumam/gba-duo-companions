            "navigate": "library"
           }
          ],
          "children": [
           {
            "type": "box",
            "class": "arrrow",
            "children": [
             {
              "type": "text",
              "class": "nb",
              "text": "Library"
             },
             {
              "type": "image",
              "class": "nb arr arr-r",
              "src": "asset:ui/arr-r-fff7ce-292929.png"
             }
            ]
           }
          ]
         }
        ]
       }
      ]
     }
    },
