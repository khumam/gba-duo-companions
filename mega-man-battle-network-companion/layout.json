             },
             {
              "type": "box",
              "class": "card-dot",
              "children": []
             },
             {
              "type": "text",
              "class": "card-atk",
              "text": "{selChip.atkText}"
             }
            ]
           },
           {
            "type": "box",
            "class": "desc",
            "children": [
             {
              "type": "text",
              "class": "desc-t",
              "text": "{selChip.desc}"
             }
