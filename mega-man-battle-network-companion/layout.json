       "type": "text",
       "class": "wait-title",
       "text": "MEGA MAN"
      },
      {
       "type": "text",
       "class": "wait-sub",
       "text": "BATTLE NETWORK"
      },
      {
       "type": "text",
       "class": "wait-line",
       "text": "Load your save to jog Lan's PET"
      }
     ]
    }
   ],
   "visibleIf": "$waiting"
  },
  {
   "type": "pages",
   "class": "stage",
