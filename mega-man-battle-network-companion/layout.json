              "class": "codes-list",
              "items": "$selCodes",
              "template": {
               "type": "button",
               "class": "cpill",
               "onClick": [
                {
                 "call": "setCode",
                 "args": [
                  "{slot}",
                  "{code}"
                 ]
                }
               ],
               "children": [
                {
                 "type": "text",
                 "class": "cpill-t",
                 "text": "{ch}"
                }
               ],
               "classIf": {
                "on": "$on"
               }
              }
             }
            ]
           }
          ]
         },
         {
          "type": "box",
          "class": "list-panel",
          "children": [
           {
            "type": "list",
            "class": "rows",
            "items": "$folder",
            "template": {
             "type": "button",
             "class": "row",
             "onClick": [
              {
               "set": {
                "slot": "{slot}"
               }
              }
             ],
             "children": [
              {
               "type": "image",
               "class": "row-icon",
               "src": "$icon"
              },
              {
               "type": "text",
               "class": "row-name",
               "text": "{name}"
              },
              {
               "type": "box",
               "class": "row-dot",
               "children": []
              },
              {
               "type": "text",
               "class": "row-code",
               "text": "{code}"
