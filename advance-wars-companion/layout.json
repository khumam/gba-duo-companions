                  "type": "text",
                  "class": "lab",
                  "text": "MOVE"
                 },
                 {
                  "type": "text",
                  "class": "cell-v",
                  "text": "{focus.move}"
                 }
                ]
               },
               {
                "type": "box",
                "class": "cell",
                "children": [
                 {
                  "type": "text",
                  "class": "lab",
                  "text": "VISION"
                 },
                 {
                  "type": "text",
                  "class": "cell-v",
                  "text": "{focus.vision}"
                 }
                ]
               },
               {
                "type": "box",
                "class": "cell",
                "children": [
                 {
                  "type": "text",
                  "class": "lab",
                  "text": "RANGE"
                 },
                 {
                  "type": "text",
                  "class": "cell-v",
                  "text": "{focus.range}"
                 }
                ]
               },
               {
                "type": "box",
                "class": "cell",
                "children": [
                 {
                  "type": "text",
                  "class": "lab",
                  "text": "AMMO"
                 },
                 {
                  "type": "text",
                  "class": "cell-v",
                  "text": "{focus.ammo}"
                 }
                ]
               },
               {
                "type": "box",
                "class": "cell",
                "children": [
