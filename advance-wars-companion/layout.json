    {
     "type": "box",
     "class": "center",
     "children": [
      {
       "type": "pages",
       "class": "stage",
       "initial": "home",
       "pages": [
        {
         "name": "home",
         "child": {
          "type": "box",
          "class": "page",
          "children": [
           {
            "type": "box",
            "class": "strip",
            "children": [
             {
              "type": "box",
              "class": "stat",
              "children": [
               {
                "type": "text",
                "class": "lab",
                "text": "DAY"
               },
               {
                "type": "text",
                "class": "val",
                "text": "{day}"
               }
              ]
             },
             {
              "type": "box",
              "class": "stat grow",
              "children": [
               {
                "type": "text",
                "class": "lab",
                "text": "TURN"
               },
               {
                "type": "text",
                "class": "val",
                "text": "{turnName}",
                "bindStyle": {
                 "color": "{turnColor}"
                }
               }
              ]
             },
             {
              "type": "box",
              "class": "stat",
              "children": [
               {
                "type": "text",
                "class": "lab",
                "text": "FUNDS"
               },
               {
                "type": "text",
                "class": "val",
                "text": "{funds}"
               }
              ]
             }
            ]
           },
           {
            "type": "box",
            "class": "panel fill",
            "children": [
             {
              "type": "list",
              "class": "armies",
              "items": "$armies",
              "template": {
               "type": "button",
               "class": "army",
               "onClick": [
                {
                 "set": {
                  "army": "{n}"
                 }
                },
                {
                 "navigate": "units"
                }
               ],
               "children": [
                {
                 "type": "box",
                 "class": "flag",
                 "children": [],
                 "bindStyle": {
                  "background-color": "{color}"
                 }
                },
                {
                 "type": "box",
                 "class": "army-body",
                 "children": [
                  {
                   "type": "text",
                   "class": "army-name",
                   "text": "{name}"
                  },
                  {
                   "type": "text",
                   "class": "army-sub",
                   "text": "{count} units     value {value}"
                  }
                 ]
                },
                {
                 "type": "text",
                 "class": "turn-mark",
                 "text": "TURN",
                 "visibleIf": "$mine"
                },
                {
                 "type": "image",
                 "class": "go",
                 "src": "asset:ui/arr-r-dark.png"
                }
               ],
               "classIf": {
                "on": "$on"
               }
              }
             },
             {
              "type": "text",
              "class": "sub",
              "text": "{sel.name}: unit types"
             },
             {
              "type": "box",
              "class": "scroll",
              "children": [
               {
                "type": "list",
                "class": "groups",
                "items": "$groups",
                "template": {
                 "type": "box",
                 "class": "grp",
                 "children": [
                  {
                   "type": "image",
                   "class": "grp-ic",
                   "src": "$icon"
                  },
                  {
                   "type": "text",
                   "class": "grp-n",
                   "text": "x{n}"
                  }
                 ]
                }
               }
              ]
             }
            ]
           }
          ]
         }
        },
        {
         "name": "units",
         "child": {
          "type": "box",
          "class": "page",
          "children": [
           {
            "type": "list",
            "class": "tabs",
            "items": "$armies",
            "template": {
             "type": "button",
             "class": "tabbtn",
             "onClick": [
