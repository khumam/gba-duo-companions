               "set": {
                "army": "{n}"
               }
              }
             ],
             "children": [
              {
               "type": "box",
               "class": "dot",
               "children": [],
               "bindStyle": {
                "background-color": "{color}"
               }
              },
              {
               "type": "text",
               "class": "tabt",
               "text": "{name}"
              }
             ],
             "classIf": {
              "on": "$on"
             }
            }
           },
           {
            "type": "box",
            "class": "panel fill",
            "children": [
             {
              "type": "box",
              "class": "cols",
              "children": [
               {
                "type": "text",
                "class": "c1",
                "text": "UNIT"
               },
               {
                "type": "box",
                "class": "grow",
                "children": []
               },
               {
                "type": "text",
                "class": "c2",
                "text": "HP"
               },
               {
                "type": "text",
                "class": "c3",
                "text": "FUEL"
               },
               {
                "type": "text",
                "class": "c4",
                "text": "AT"
               }
              ]
             },
             {
              "type": "list",
              "class": "rows",
              "items": "$units",
              "template": {
               "type": "button",
               "class": "row",
               "onClick": [
                {
                 "set": {
                  "unit": "{n}"
                 }
                },
                {
                 "navigate": "unit"
                }
               ],
               "children": [
                {
                 "type": "image",
                 "class": "row-ic",
                 "src": "$icon"
                },
                {
                 "type": "text",
                 "class": "row-name",
                 "text": "{name}"
                },
                {
                 "type": "box",
                 "class": "meter",
                 "children": [
                  {
                   "type": "text",
                   "class": "meter-n",
                   "text": "{tens}"
                  },
                  {
                   "type": "bar",
                   "class": "hp hpbar",
                   "value": "$hpPct",
                   "max": 1
                  }
                 ],
                 "classIf": {
                  "low": "$low"
                 }
                },
                {
                 "type": "text",
                 "class": "row-fuel",
                 "text": "{fuel}"
                },
                {
                 "type": "text",
                 "class": "row-pos",
                 "text": "{x},{y}"
                }
               ]
              }
             }
            ]
           }
          ]
         }
        },
        {
         "name": "unit",
