               "visibleIf": "$onTerrain"
              }
             ]
            },
            {
             "type": "image",
             "class": "n-ic n-terrain",
             "src": "asset:terrain/mountain.png"
            },
            {
             "type": "text",
             "class": "n-t",
             "text": "Terrain"
            }
           ],
           "classIf": {
            "on": "$onTerrain"
           }
          },
          {
           "type": "button",
           "class": "nrow",
           "onClick": [
            {
             "navigate": "map"
            }
           ],
           "children": [
            {
             "type": "box",
             "class": "nglove-w",
             "children": [
              {
               "type": "image",
               "class": "glove",
               "src": "asset:ui/hand.png",
               "visibleIf": "$onMap"
              }
             ]
            },
            {
             "type": "image",
             "class": "n-ic n-map",
             "src": "asset:ui/tab-map.png"
            },
            {
             "type": "text",
             "class": "n-t",
             "text": "Map"
            }
           ],
           "classIf": {
            "on": "$onMap"
           }
          }
         ]
        }
       ]
      },
      {
       "type": "box",
       "class": "win day grow",
       "children": [
        {
         "type": "box",
         "class": "cap-none",
         "children": []
        },
        {
         "type": "box",
         "class": "win-in",
         "children": [
          {
           "type": "box",
           "class": "day-top",
           "children": [
            {
             "type": "image",
             "class": "emblem",
             "src": "$crate"
            },
            {
             "type": "text",
             "class": "day-l",
             "text": "Day"
            },
            {
             "type": "box",
             "class": "grow",
             "children": []
            },
            {
             "type": "text",
             "class": "day-n",
             "text": "{day}"
            }
           ]
          },
          {
           "type": "box",
           "class": "rule",
           "children": []
          },
          {
           "type": "box",
           "class": "grow",
           "children": []
          },
          {
           "type": "box",
           "class": "day-funds",
           "children": [
            {
             "type": "image",
             "class": "d-coin",
             "src": "asset:icons/ui/coin.png"
            },
            {
             "type": "box",
             "class": "grow",
             "children": []
            },
            {
             "type": "text",
             "class": "funds",
             "text": "{funds}"
            }
           ]
          },
          {
           "type": "text",
           "class": "income",
           "text": "+{income} / day",
           "visibleIf": "$hasIncome"
          }
         ]
        }
       ]
      }
     ]
    }
   ],
   "visibleIf": "$ready"
  }
 ],
 "id": "screen",
 "bindStyle": {
  "--acc": "{accent}",
  "--pill": "{pill}",
  "--foe": "{foeAcc}"
 }
}