{
 "type": "box",
 "class": "main",
 "children": [
  {
   "type": "box",
   "class": "waiting",
   "children": [
    {
     "type": "box",
     "class": "wait",
     "children": [
      {
       "type": "text",
       "class": "w1",
       "text": "ADVANCE"
      },
      {
       "type": "text",
       "class": "w2",
       "text": "WARS"
      },
      {
       "type": "text",
       "class": "w3",
       "text": "GBADUO Companion Pack"
      }
     ]
    }
   ],
   "visibleIf": "$waiting"
  },
  {
   "type": "box",
   "class": "ready",
   "children": [
    {
     "type": "box",
     "class": "dock",
     "children": [
      {
       "type": "button",
       "class": "dbtn",
       "onClick": [
        {
         "navigate": "home"
        }
       ],
       "children": [
        {
         "type": "text",
         "class": "dt",
         "text": "FRONT"
        }
       ],
       "classIf": {
        "on": "$on1"
       },
       "visibleIf": "$L1"
      },
      {
       "type": "button",
       "class": "dbtn",
       "onClick": [
        {
         "navigate": "units"
        }
       ],
       "children": [
        {
         "type": "text",
         "class": "dt",
         "text": "UNITS"
        }
       ],
       "classIf": {
        "on": "$on2"
       },
       "visibleIf": "$L2"
      },
      {
       "type": "button",
       "class": "dbtn",
       "onClick": [
        {
         "navigate": "map"
        }
       ],
       "children": [
        {
         "type": "text",
         "class": "dt",
         "text": "MAP"
        }
       ],
       "classIf": {
        "on": "$on3"
       },
       "visibleIf": "$L3"
      },
      {
       "type": "button",
       "class": "dbtn",
       "onClick": [
        {
         "navigate": "armies"
        }
       ],
       "children": [
        {
         "type": "text",
         "class": "dt",
         "text": "VS"
        }
       ],
       "classIf": {
        "on": "$on4"
       },
       "visibleIf": "$L4"
      },
      {
       "type": "button",
       "class": "dbtn",
       "onClick": [
        {
         "navigate": "guide"
        }
       ],
       "children": [
        {
         "type": "text",
         "class": "dt",
         "text": "GUIDE"
        }
       ],
       "classIf": {
        "on": "$on5"
       },
       "visibleIf": "$L5"
      },
      {
       "type": "button",
       "class": "dbtn",
       "onClick": [
        {
         "navigate": "log"
        }
       ],
       "children": [
        {
         "type": "text",
         "class": "dt",
         "text": "LOG"
        }
       ],
       "classIf": {
        "on": "$on6"
       },
       "visibleIf": "$L6"
      },
      {
       "type": "button",
       "class": "dbtn",
       "onClick": [
        {
         "navigate": "options"
        }
       ],
       "children": [
        {
         "type": "text",
         "class": "dt",
         "text": "OPT"
        }
       ],
