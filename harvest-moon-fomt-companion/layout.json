{
 "type": "box",
 "class": "screen",
 "children": [
  {
   "type": "box",
   "class": "win waiting",
   "visibleIf": "$waiting",
   "children": [
    {
     "type": "text",
     "class": "w-title",
     "text": "Harvest Moon"
    },
    {
     "type": "text",
     "class": "w-sub",
     "text": "Friends of Mineral Town"
    },
    {
     "type": "text",
     "class": "w-hint",
     "text": "Load your farm to begin"
    }
   ]
  },
  {
   "type": "box",
   "class": "main",
   "visibleIf": "$ready",
   "children": [
    {
     "type": "pages",
     "class": "stage",
     "state": "page",
     "initial": "farm",
     "pages": [
      {
       "name": "farm",
       "child": {
        "type": "box",
        "class": "page",
        "children": [
         {
          "type": "box",
          "class": "bar",
          "children": [
           {
            "type": "text",
            "class": "bar-title",
            "text": "{farm} Property"
           },
           {
            "type": "text",
            "class": "bar-right",
            "text": "{season} {day}  {weekday}  {clock}",
            "visibleIf": "$hasClock"
           }
          ]
         },
         {
          "type": "text",
          "class": "note",
          "text": "Clock, family and weather are sample values (not live yet)",
          "visibleIf": "$isSample"
         },
         {
          "type": "box",
          "class": "scroll",
          "children": [
           {
            "type": "row",
            "class": "topline",
            "children": [
             {
              "type": "box",
              "class": "win gold-win",
              "children": [
               {
                "type": "row",
                "class": "gold-row",
                "children": [
                 {
                  "type": "image",
                  "class": "coin",
                  "src": "$coinIcon"
                 },
                 {
                  "type": "text",
                  "class": "gold",
                  "text": "{gold}G"
                 }
                ]
               },
               {
                "type": "text",
                "class": "dim",
                "text": "{player}  -  {weather}",
                "visibleIf": "$hasClock"
               }
              ]
             },
             {
              "type": "box",
              "class": "gold-col",
              "children": [
               {
                "type": "box",
                "class": "btn",
                "onClick": {
                 "call": "addGold",
                 "args": [
                  1000
                 ]
                },
                "children": [
                 {
                  "type": "text",
                  "class": "btn-t",
                  "text": "+1000G"
                 }
                ]
               },
               {
                "type": "box",
                "class": "btn",
                "onClick": {
                 "call": "addGold",
                 "args": [
                  10000
                 ]
                },
                "children": [
                 {
                  "type": "text",
                  "class": "btn-t",
                  "text": "+10000G"
                 }
                ]
               }
              ]
             }
            ]
           },
           {
            "type": "box",
            "class": "win",
            "children": [
             {
              "type": "text",
              "class": "sec",
              "text": "Family"
             },
             {
              "type": "list",
              "class": "family",
              "items": "$family",
              "template": {
               "type": "box",
               "class": "fam",
               "children": [
                {
                 "type": "image",
                 "class": "fam-icon",
                 "src": "$icon"
                },
                {
                 "type": "box",
                 "class": "fam-main",
                 "children": [
                  {
                   "type": "row",
                   "class": "fam-top",
                   "children": [
                    {
                     "type": "text",
                     "class": "fam-name",
                     "text": "{name}"
                    },
                    {
                     "type": "text",
                     "class": "fam-role",
                     "text": "{role}"
                    },
                    {
                     "type": "image",
                     "class": "crown",
                     "src": "asset:ui/crown.png",
                     "visibleIf": "$crown"
                    }
                   ]
                  },
                  {
                   "type": "list",
                   "class": "hrow",
                   "items": "$heartRow",
                   "template": {
                    "type": "image",
                    "class": "heart",
                    "src": "$src"
                   },
                   "visibleIf": "$hasHearts"
                  },
                  {
                   "type": "list",
                   "class": "hrow",
                   "items": "$berryRow",
                   "visibleIf": "$hasBerries",
                   "template": {
                    "type": "image",
                    "class": "berry",
                    "src": "$src"
                   }
                  }
                 ]
                }
               ]
              }
             }
            ]
           },
           {
            "type": "row",
            "class": "tiles",
            "children": [
             {
              "type": "box",
              "class": "win tile",
              "onClick": {
               "navigate": "barn"
              },
              "children": [
               {
                "type": "image",
                "class": "tile-icon",
                "src": "asset:ui/barn.png"
               },
               {
                "type": "text",
                "class": "tile-big",
                "text": "{chickenCount} + {barnCount}"
               },
               {
                "type": "text",
                "class": "tile-sm",
                "text": "animals"
               }
              ]
             },
             {
              "type": "box",
              "class": "win tile",
              "onClick": {
               "navigate": "memo"
              },
              "children": [
               {
                "type": "image",
                "class": "tile-icon",
                "src": "asset:ui/crate.png"
               },
               {
                "type": "text",
                "class": "tile-big",
                "text": "{shipKinds}"
               },
               {
                "type": "text",
                "class": "tile-sm",
                "text": "kinds shipped"
               }
              ]
             },
             {
              "type": "box",
              "class": "win tile alert-tile",
              "visibleIf": "$hasSick",
              "onClick": {
               "navigate": "barn"
              },
              "children": [
               {
                "type": "text",
                "class": "tile-big",
                "text": "{sickCount}"
               },
               {
                "type": "text",
                "class": "tile-sm",
                "text": "sick - tap"
               }
              ]
             }
            ]
           }
          ]
         }
        ]
       }
      },
      {
       "name": "ruck",
       "child": {
        "type": "box",
        "class": "page",
        "children": [
         {
          "type": "box",
          "class": "bar",
          "children": [
           {
            "type": "text",
            "class": "bar-title",
            "text": "Rucksack"
           }
          ]
         },
         {
          "type": "box",
          "class": "scroll",
          "children": [
           {
            "type": "box",
            "class": "win",
            "children": [
             {
              "type": "text",
              "class": "sec",
              "text": "Tools"
             },
             {
              "type": "list",
              "class": "grid",
              "items": "$tools",
              "template": {
               "type": "box",
               "class": "slot",
               "classIf": {
                "empty": "$empty"
               },
               "onClick": {
                "set": {
                 "tool": "{name}"
                }
               },
               "children": [
                {
                 "type": "image",
                 "class": "slot-icon",
                 "src": "$icon"
                },
                {
                 "type": "text",
                 "class": "slot-name",
                 "text": "{name}"
                }
               ]
              }
             }
            ]
           },
           {
            "type": "box",
            "class": "win",
            "children": [
             {
              "type": "text",
              "class": "sec",
              "text": "Items"
             },
             {
              "type": "list",
              "class": "grid",
              "items": "$itemGrid",
              "template": {
               "type": "box",
               "class": "slot",
               "classIf": {
                "empty": "$empty"
               },
               "onClick": {
                "set": {
                 "tool": "{name}"
                }
               },
               "children": [
                {
                 "type": "image",
                 "class": "slot-icon",
                 "src": "$icon"
                },
                {
                 "type": "text",
                 "class": "slot-name",
                 "text": "{name}"
                }
               ]
              }
             },
             {
              "type": "text",
              "class": "dim",
              "text": "Rucksack items: empty",
              "visibleIf": "$noItems"
             }
            ]
           }
          ]
         }
        ]
       }
      },
      {
       "name": "barn",
       "child": {
        "type": "box",
        "class": "page",
        "children": [
         {
          "type": "box",
          "class": "bar",
          "children": [
           {
            "type": "text",
            "class": "bar-title",
            "text": "Livestock"
           }
          ]
         },
         {
          "type": "text",
          "class": "note",
          "text": "Sprites tab shows sample values (not live yet)",
          "visibleIf": "$tbSprites"
         },
         {
          "type": "row",
          "class": "pills",
          "children": [
           {
            "type": "box",
            "class": "pill",
            "classIf": {
             "on": "$tbChickens"
            },
            "onClick": {
             "set": {
              "barnTab": "chickens"
             }
            },
            "children": [
             {
              "type": "text",
              "class": "pill-t",
              "text": "Chickens"
             }
            ]
           },
           {
            "type": "box",
            "class": "pill",
            "classIf": {
             "on": "$tbCattle"
            },
            "onClick": {
             "set": {
              "barnTab": "cattle"
             }
            },
            "children": [
             {
              "type": "text",
              "class": "pill-t",
              "text": "Cattle"
             }
            ]
           },
           {
            "type": "box",
            "class": "pill",
            "classIf": {
             "on": "$tbSheep"
            },
            "onClick": {
             "set": {
              "barnTab": "sheep"
             }
            },
            "children": [
             {
              "type": "text",
              "class": "pill-t",
              "text": "Sheep"
             }
            ]
           },
           {
            "type": "box",
            "class": "pill",
            "classIf": {
             "on": "$tbSprites"
            },
            "onClick": {
             "set": {
              "barnTab": "sprites"
             }
            },
            "children": [
             {
              "type": "text",
              "class": "pill-t",
              "text": "Sprites"
             }
            ]
           }
          ]
         },
         {
          "type": "box",
          "class": "scroll",
          "children": [
           {
            "type": "box",
            "class": "tabbody",
            "visibleIf": "$tbChickens",
            "children": [
             {
              "type": "list",
              "class": "clist",
              "items": "$chickens",
              "template": {
               "type": "box",
               "class": "win crow",
               "classIf": {
                "sick": "$sick"
               },
               "onClick": {
                "set": {
                 "animal": "{idx}",
                 "kind": "coop",
                 "note": ""
                }
               },
               "children": [
                {
                 "type": "row",
                 "class": "crow-top",
                 "children": [
                  {
                   "type": "image",
                   "class": "chick",
                   "src": "$icon"
                  },
                  {
                   "type": "text",
                   "class": "cname",
                   "text": "{name}"
                  },
                  {
                   "type": "text",
                   "class": "chealth",
                   "text": "{health}",
                   "classIf": {
                    "sick": "$sick"
                   }
                  }
                 ]
                },
                {
                 "type": "list",
                 "class": "hrow",
                 "items": "$heartRow",
                 "template": {
                  "type": "image",
                  "class": "heart",
                  "src": "$src"
                 }
                }
               ]
              }
             }
            ]
           },
           {
            "type": "box",
            "class": "tabbody",
            "visibleIf": "$tbCattle",
            "children": [
             {
              "type": "list",
              "class": "clist",
              "items": "$cattle",
              "template": {
               "type": "box",
               "class": "win crow",
               "classIf": {
                "sick": "$sick"
               },
               "onClick": {
                "set": {
                 "animal": "{idx}",
                 "kind": "barn",
                 "note": ""
                }
               },
               "children": [
                {
                 "type": "row",
                 "class": "crow-top",
                 "children": [
                  {
                   "type": "image",
                   "class": "chick",
                   "src": "$icon"
                  },
                  {
                   "type": "text",
                   "class": "cname",
                   "text": "{name}"
                  },
                  {
                   "type": "text",
                   "class": "chealth",
                   "text": "{health}",
                   "classIf": {
                    "sick": "$sick"
                   }
                  }
                 ]
                },
                {
                 "type": "list",
                 "class": "hrow",
                 "items": "$heartRow",
                 "template": {
                  "type": "image",
                  "class": "heart",
                  "src": "$src"
                 }
                }
               ]
              }
             }
            ]
           },
           {
            "type": "box",
            "class": "tabbody",
            "visibleIf": "$tbSheep",
            "children": [
             {
              "type": "list",
              "class": "clist",
              "items": "$sheep",
              "template": {
               "type": "box",
               "class": "win crow",
               "classIf": {
                "sick": "$sick"
               },
               "onClick": {
                "set": {
                 "animal": "{idx}",
                 "kind": "barn",
                 "note": ""
                }
               },
               "children": [
                {
                 "type": "row",
                 "class": "crow-top",
                 "children": [
                  {
                   "type": "image",
                   "class": "chick",
                   "src": "$icon"
                  },
                  {
                   "type": "text",
                   "class": "cname",
                   "text": "{name}"
                  },
                  {
                   "type": "text",
                   "class": "chealth",
                   "text": "{health}",
                   "classIf": {
                    "sick": "$sick"
                   }
                  }
                 ]
                },
                {
                 "type": "list",
                 "class": "hrow",
                 "items": "$heartRow",
                 "template": {
                  "type": "image",
                  "class": "heart",
                  "src": "$src"
                 }
                }
               ]
              }
             }
            ]
           },
           {
            "type": "box",
            "class": "tabbody",
            "visibleIf": "$tbSprites",
            "children": [
             {
              "type": "list",
              "class": "clist",
              "items": "$sprites",
              "template": {
               "type": "box",
               "class": "win crow",
               "children": [
                {
                 "type": "row",
                 "class": "crow-top",
                 "children": [
                  {
                   "type": "image",
                   "class": "chick",
                   "src": "$icon"
                  },
                  {
                   "type": "text",
                   "class": "cname",
                   "text": "{name}"
                  },
                  {
                   "type": "text",
                   "class": "chealth",
                   "text": "{state}"
                  }
                 ]
                },
                {
                 "type": "list",
                 "class": "hrow",
                 "items": "$heartRow",
                 "template": {
                  "type": "image",
                  "class": "heart",
                  "src": "$src"
                 }
                },
                {
                 "type": "row",
                 "class": "bars",
                 "children": [
                  {
                   "type": "text",
                   "class": "bar-l",
                   "text": "{job}"
                  },
                  {
                   "type": "bar",
                   "class": "meter",
                   "value": "$b1",
                   "max": 1
                  },
                  {
                   "type": "bar",
                   "class": "meter m2",
                   "value": "$b2",
                   "max": 1
                  },
                  {
                   "type": "bar",
                   "class": "meter m3",
                   "value": "$b3",
                   "max": 1
                  }
                 ]
                }
               ]
              }
             }
            ]
           }
          ]
         }
        ]
       }
      },
      {
       "name": "maps",
       "child": {
        "type": "box",
        "class": "page",
        "children": [
         {
          "type": "box",
          "class": "bar",
          "children": [
           {
            "type": "text",
            "class": "bar-title",
            "text": "Maps"
           }
          ]
         },
         {
          "type": "text",
          "class": "note",
          "text": "Marker positions are sample values (not live yet)",
          "visibleIf": "$isSample"
         },
         {
          "type": "row",
          "class": "pills",
          "children": [
           {
            "type": "box",
            "class": "pill",
            "classIf": {
             "on": "$mpTown"
            },
            "onClick": {
             "set": {
              "mapTab": "town"
             }
            },
            "children": [
             {
              "type": "text",
              "class": "pill-t",
              "text": "Town"
             }
            ]
           },
           {
            "type": "box",
            "class": "pill",
            "classIf": {
             "on": "$mpFarm"
            },
            "onClick": {
             "set": {
              "mapTab": "farm"
             }
            },
            "children": [
             {
              "type": "text",
              "class": "pill-t",
              "text": "Farm"
             }
            ]
           }
          ]
         },
         {
          "type": "box",
          "class": "tabbody",
          "visibleIf": "$mpTown",
          "children": [
           {
            "type": "box",
            "class": "win map-win",
            "children": [
             {
              "type": "box",
              "class": "map-view",
              "children": [
               {
                "type": "image",
                "class": "map-img",
                "src": "asset:ui/map-world.png"
               },
               {
                "type": "image",
                "class": "mk",
                "src": "$mkDog",
                "bindStyle": {
                 "left": "{dogX}%",
                 "top": "{dogY}%"
                }
               },
               {
                "type": "image",
                "class": "mk",
                "src": "$mkHorse",
                "bindStyle": {
                 "left": "{horseX}%",
                 "top": "{horseY}%"
                }
               },
               {
                "type": "image",
                "class": "mk mk-me",
                "src": "$mkPlayer",
                "bindStyle": {
                 "left": "{playerX}%",
                 "top": "{playerY}%"
                }
               }
              ]
             }
            ]
           },
           {
            "type": "box",
            "class": "win",
            "children": [
             {
              "type": "row",
              "class": "where",
              "children": [
               {
                "type": "image",
                "class": "chick",
                "src": "asset:ui/pawn.png"
               },
               {
                "type": "text",
                "class": "val",
                "text": "{where}"
               }
              ]
             }
            ]
           },
           {
            "type": "row",
            "class": "legend",
            "children": [
             {
              "type": "row",
              "class": "leg",
              "children": [
               {
                "type": "image",
                "class": "leg-i",
                "src": "$mkPlayer"
               },
               {
                "type": "text",
                "class": "leg-t",
                "text": "You"
               }
              ]
             },
             {
              "type": "row",
              "class": "leg",
              "children": [
               {
                "type": "image",
                "class": "leg-i",
                "src": "$mkDog"
               },
               {
                "type": "text",
                "class": "leg-t",
                "text": "Spunky"
               }
              ]
             },
             {
              "type": "row",
              "class": "leg",
              "children": [
               {
                "type": "image",
                "class": "leg-i",
                "src": "$mkHorse"
               },
               {
                "type": "text",
                "class": "leg-t",
                "text": "Speedy"
               }
              ]
             }
            ]
           }
          ]
         },
         {
          "type": "box",
          "class": "tabbody",
          "visibleIf": "$mpFarm",
          "children": [
           {
            "type": "box",
            "class": "scroll",
            "children": [
             {
              "type": "box",
              "class": "win map-win",
              "children": [
               {
                "type": "box",
                "class": "farm-view",
                "children": [
                 {
                  "type": "image",
                  "class": "farm-img",
                  "src": "asset:ui/map-farm.png"
                 },
                 {
                  "type": "image",
                  "class": "mk mk-me",
                  "src": "$mkPlayer",
                  "bindStyle": {
                   "left": "{farmX}%",
                   "top": "{farmY}%"
                  }
                 }
                ]
               }
              ]
             }
            ]
           }
          ]
         }
        ]
       }
      },
      {
       "name": "memo",
       "child": {
        "type": "box",
        "class": "page",
        "children": [
         {
          "type": "box",
          "class": "bar",
          "children": [
           {
            "type": "text",
            "class": "bar-title",
            "text": "Memo"
           }
          ]
         },
         {
          "type": "text",
          "class": "note",
          "text": "Fishing and records are sample values (not live yet)",
          "visibleIf": "$tmOther"
         },
         {
          "type": "row",
          "class": "pills",
          "children": [
           {
            "type": "box",
            "class": "pill",
            "classIf": {
             "on": "$tmShip"
            },
            "onClick": {
             "set": {
              "memoTab": "ship"
             }
            },
            "children": [
             {
              "type": "text",
              "class": "pill-t",
              "text": "Shipped"
             }
            ]
           },
           {
            "type": "box",
            "class": "pill",
            "classIf": {
             "on": "$tmFish"
            },
            "onClick": {
             "set": {
              "memoTab": "fish"
             }
            },
            "children": [
             {
              "type": "text",
              "class": "pill-t",
              "text": "Fishing"
             }
            ]
           },
           {
            "type": "box",
            "class": "pill",
            "classIf": {
             "on": "$tmRec"
            },
            "onClick": {
             "set": {
              "memoTab": "rec"
             }
            },
            "children": [
             {
              "type": "text",
              "class": "pill-t",
              "text": "Records"
             }
            ]
           }
          ]
         },
         {
          "type": "text",
          "class": "dim pad",
          "text": "Nothing shipped yet",
          "visibleIf": "$noShipped"
         },
         {
          "type": "box",
          "class": "scroll",
          "children": [
           {
            "type": "box",
            "class": "tabbody",
            "visibleIf": "$tmShip",
            "children": [
             {
              "type": "list",
              "class": "slist",
              "items": "$shipped",
              "template": {
               "type": "box",
               "class": "win srow",
               "children": [
                {
                 "type": "image",
                 "class": "chick",
                 "src": "$icon"
                },
                {
                 "type": "box",
                 "class": "sname-col",
                 "children": [
                  {
                   "type": "text",
                   "class": "sname",
                   "text": "{name}"
                  },
                  {
                   "type": "text",
                   "class": "sgroup",
                   "text": "{group}"
                  }
                 ]
                },
                {
                 "type": "text",
                 "class": "scount",
                 "text": "{count}"
                }
               ]
              }
             }
            ]
           },
           {
            "type": "box",
            "class": "tabbody",
            "visibleIf": "$tmFish",
            "children": [
             {
              "type": "list",
              "class": "slist",
              "items": "$fishing",
              "template": {
               "type": "box",
               "class": "win srow",
               "children": [
                {
                 "type": "image",
                 "class": "chick",
                 "src": "asset:ui/fish.png"
                },
                {
                 "type": "box",
                 "class": "sname-col",
                 "children": [
                  {
                   "type": "text",
                   "class": "sname",
                   "text": "{name}"
                  },
                  {
                   "type": "text",
                   "class": "sgroup",
                   "text": "Largest {size}"
                  }
                 ]
                },
                {
                 "type": "text",
                 "class": "scount",
                 "text": "{count}"
                }
               ]
              }
             }
            ]
           },
           {
            "type": "box",
            "class": "tabbody",
            "visibleIf": "$tmRec",
            "children": [
             {
              "type": "box",
              "class": "win",
              "children": [
               {
                "type": "text",
                "class": "sec",
                "text": "Mini-game records"
               },
               {
                "type": "list",
                "class": "slist",
                "items": "$records",
                "template": {
                 "type": "box",
                 "class": "win srow",
                 "children": [
                  {
                   "type": "box",
                   "class": "sname-col",
                   "children": [
                    {
                     "type": "text",
                     "class": "sname",
                     "text": "{name}"
                    }
                   ]
                  },
                  {
                   "type": "text",
                   "class": "scount",
                   "text": "{value}"
                  }
                 ]
                }
               }
              ]
             },
             {
              "type": "box",
              "class": "win",
              "children": [
               {
                "type": "text",
                "class": "sec",
                "text": "Income / expenses"
               },
               {
                "type": "list",
                "class": "slist",
                "items": "$income",
                "template": {
                 "type": "box",
                 "class": "win srow",
                 "children": [
                  {
                   "type": "box",
                   "class": "sname-col",
                   "children": [
                    {
                     "type": "text",
                     "class": "sname",
                     "text": "{name}"
                    }
                   ]
                  },
                  {
                   "type": "text",
                   "class": "scount",
                   "text": "{value}"
                  }
                 ]
                }
               }
              ]
             }
            ]
           }
          ]
         }
        ]
       }
      }
     ]
    },
    {
     "type": "box",
     "class": "sheet",
     "visibleIf": "$dName",
     "children": [
      {
       "type": "box",
       "class": "win pop",
       "children": [
        {
         "type": "text",
         "class": "pop-name",
         "text": "{dName}"
        },
        {
         "type": "text",
         "class": "val",
         "text": "{dHealth}  -  {dHearts} hearts"
        },
        {
         "type": "list",
         "class": "hrow big",
         "items": "$dRow",
         "template": {
          "type": "image",
          "class": "heart",
          "src": "$src"
         }
        },
        {
         "type": "row",
         "class": "pop-btns",
         "children": [
          {
           "type": "box",
           "class": "btn",
           "onClick": {
            "call": "heal",
            "args": [
             "{ui.kind}",
             "{ui.animal}"
            ]
           },
           "children": [
            {
             "type": "text",
             "class": "btn-t",
             "text": "CURE"
            }
           ]
          },
          {
           "type": "box",
           "class": "btn",
           "onClick": {
            "call": "maxHearts",
            "args": [
             "{ui.kind}",
             "{ui.animal}"
            ]
           },
           "children": [
            {
             "type": "text",
             "class": "btn-t",
             "text": "MAX HEARTS"
            }
           ]
          },
          {
           "type": "box",
           "class": "btn",
           "onClick": {
            "set": {
             "animal": false
            }
           },
           "children": [
            {
             "type": "text",
             "class": "btn-t",
             "text": "CLOSE"
            }
           ]
          }
         ]
        },
        {
         "type": "text",
         "class": "dim",
         "text": "{ui.note}",
         "visibleIf": "$ui.note"
        }
       ]
      }
     ]
    },
    {
     "type": "box",
     "class": "sheet",
     "visibleIf": "$ui.tool",
     "children": [
      {
       "type": "box",
       "class": "win pop",
       "children": [
        {
         "type": "text",
         "class": "pop-name",
         "text": "{ui.tool}"
        },
        {
         "type": "row",
         "class": "pop-btns",
         "children": [
          {
           "type": "box",
           "class": "btn",
           "onClick": {
            "set": {
             "tool": false
            }
           },
           "children": [
            {
             "type": "text",
             "class": "btn-t",
             "text": "CLOSE"
            }
           ]
          }
         ]
        }
       ]
      }
     ]
    },
    {
     "type": "row",
     "class": "nav",
     "children": [
      {
       "type": "button",
       "class": "nav-btn",
       "classIf": {
        "on": "$navFarm"
       },
       "onClick": [
        {
         "navigate": "farm"
        }
       ],
       "children": [
        {
         "type": "image",
         "class": "nav-i",
         "src": "asset:ui/coin.png"
        },
        {
         "type": "text",
         "class": "nav-text",
         "text": "Farm"
        }
       ]
      },
      {
       "type": "button",
       "class": "nav-btn",
       "classIf": {
        "on": "$navRuck"
       },
       "onClick": [
        {
         "navigate": "ruck"
        }
       ],
       "children": [
        {
         "type": "image",
         "class": "nav-i",
         "src": "asset:ui/tool.png"
        },
        {
         "type": "text",
         "class": "nav-text",
         "text": "Pack"
        }
       ]
      },
      {
       "type": "button",
       "class": "nav-btn",
       "classIf": {
        "on": "$navBarn"
       },
       "onClick": [
        {
         "navigate": "barn"
        }
       ],
       "children": [
        {
         "type": "image",
         "class": "nav-i",
         "src": "asset:ui/chicken.png"
        },
        {
         "type": "text",
         "class": "nav-text",
         "text": "Barn"
        }
       ]
      },
      {
       "type": "button",
       "class": "nav-btn",
       "classIf": {
        "on": "$navMaps"
       },
       "onClick": [
        {
         "navigate": "maps"
        }
       ],
       "children": [
        {
         "type": "image",
         "class": "nav-i",
         "src": "asset:ui/pawn.png"
        },
        {
         "type": "text",
         "class": "nav-text",
         "text": "Maps"
        }
       ]
      },
      {
       "type": "button",
       "class": "nav-btn",
       "classIf": {
        "on": "$navMemo"
       },
       "onClick": [
        {
         "navigate": "memo"
        }
       ],
       "children": [
        {
         "type": "image",
         "class": "nav-i",
         "src": "asset:ui/crate.png"
        },
        {
         "type": "text",
         "class": "nav-text",
         "text": "Memo"
        }
       ]
      }
     ]
    }
   ]
  }
 ]
}