{
  "type": "box",
  "id": "screen",
  "classIf": { "spring": "$isSpring", "summer": "$isSummer", "fall": "$isFall", "winter": "$isWinter" },
  "children": [
    { "type": "box", "class": "dusk-veil", "visibleIf": "$isDusk", "children": [] },
    { "type": "box", "class": "night-veil", "visibleIf": "$isNight", "children": [] },
    {
      "type": "box",
      "class": "waiting",
      "visibleIf": "$waiting",
      "children": [
        {
          "type": "box",
          "class": "welcome",
          "children": [
            { "type": "image", "class": "welcome-img", "src": "asset:img/welcome-sign.png" },
            {
              "type": "box",
              "class": "welcome-words",
              "children": [
                { "type": "text", "class": "welcome-small", "text": "Welcome to" },
                { "type": "text", "class": "welcome-big", "text": "Mineral Town" }
              ]
            }
          ]
        },
        { "type": "text", "class": "waiting-sub", "text": "Load your farm to open the almanac" }
      ]
    },
    {
      "type": "tabs",
      "visibleIf": "$ready",
      "tabs": [
        {
          "title": "Farm",
          "child": {
            "type": "box",
            "class": "tab-page",
            "children": [
              {
                "type": "box",
                "class": "paper hero",
                "children": [
                  { "type": "image", "class": "corner corner-l", "src": "$corner" },
                  { "type": "image", "class": "corner corner-r", "src": "$cornerR" },
                  {
                    "type": "box",
                    "class": "date-row",
                    "children": [
                      {
                        "type": "box",
                        "class": "date-col",
                        "children": [
                          { "type": "text", "class": "kicker", "text": "YEAR {year}" },
                          { "type": "text", "class": "date-big", "text": "{season} {day}" }
                        ]
                      },
                      {
                        "type": "box",
                        "class": "clock-chip",
                        "children": [
                          { "type": "image", "class": "icon", "src": "asset:img/clock.png" },
                          { "type": "text", "class": "clock-text", "text": "{time}" }
                        ]
                      }
                    ]
                  },
                  {
                    "type": "box",
                    "class": "weather-row",
                    "children": [
                      {
                        "type": "box",
                        "class": "weather",
                        "children": [
                          { "type": "image", "class": "weather-img", "src": "$today.icon" },
                          {
                            "type": "box",
                            "class": "col",
                            "children": [
                              { "type": "text", "class": "kicker", "text": "TODAY" },
                              { "type": "text", "class": "weather-name", "text": "{today.name}" }
                            ]
                          }
                        ]
                      },
                      {
                        "type": "box",
                        "class": "weather",
                        "children": [
                          { "type": "image", "class": "weather-img", "src": "$tomorrow.icon" },
                          {
                            "type": "box",
                            "class": "col",
                            "children": [
                              { "type": "text", "class": "kicker", "text": "TOMORROW" },
                              { "type": "text", "class": "weather-name", "text": "{tomorrow.name}" }
                            ]
                          }
                        ]
                      }
                    ]
                  }
                ]
              },
              {
                "type": "box",
                "class": "grid-2",
                "children": [
                  {
                    "type": "box",
                    "class": "paper stat",
                    "children": [
                      { "type": "image", "class": "icon-lg", "src": "asset:img/pouch.png" },
                      {
                        "type": "box",
                        "class": "col",
                        "children": [
                          { "type": "text", "class": "kicker", "text": "GOLD" },
                          { "type": "text", "class": "num gold", "text": "{moneyText} G" }
                        ]
                      }
                    ]
                  },
                  {
                    "type": "box",
                    "class": "paper stat",
                    "children": [
                      { "type": "image", "class": "icon-lg", "src": "$bag.handIcon" },
                      {
                        "type": "box",
                        "class": "col grow",
                        "children": [
                          { "type": "text", "class": "kicker", "text": "IN HAND" },
                          { "type": "text", "class": "hand-name", "text": "{bag.handTool}" }
                        ]
                      }
                    ]
                  }
                ]
              },
              {
                "type": "box",
                "class": "paper energy",
                "children": [
                  {
                    "type": "box",
                    "class": "meter",
                    "children": [
                      { "type": "image", "class": "icon", "src": "asset:img/stamina.png" },
                      {
                        "type": "box",
                        "class": "col grow",
                        "children": [
                          {
                            "type": "box",
                            "class": "meter-head",
                            "children": [
                              { "type": "text", "class": "kicker", "text": "STAMINA" },
                              { "type": "text", "class": "meter-num", "text": "{stamina} / 125" }
                            ]
                          },
                          { "type": "bar", "class": "gauge stamina-gauge", "value": "$staminaPct", "max": 1 }
                        ]
                      }
                    ]
                  },
                  {
                    "type": "box",
                    "class": "meter",
                    "children": [
                      { "type": "image", "class": "icon", "src": "asset:img/fatigue.png" },
                      {
                        "type": "box",
                        "class": "col grow",
                        "children": [
                          {
                            "type": "box",
                            "class": "meter-head",
                            "children": [
                              { "type": "text", "class": "kicker", "text": "FATIGUE" },
                              { "type": "text", "class": "meter-num", "text": "{fatigue} / 100" }
                            ]
                          },
                          { "type": "bar", "class": "gauge fatigue-gauge", "value": "$fatiguePct", "max": 1 }
                        ]
                      }
                    ]
                  }
                ]
              },
              {
                "type": "box",
                "class": "grid-2",
                "children": [
                  {
                    "type": "box",
                    "class": "paper stat",
                    "children": [
                      { "type": "image", "class": "icon", "src": "asset:img/medal.png" },
                      {
                        "type": "box",
                        "class": "col",
                        "children": [
                          { "type": "text", "class": "kicker", "text": "HORSE MEDALS" },
                          { "type": "text", "class": "num small", "text": "{horseRaceMedals}" }
                        ]
                      }
                    ]
                  },
                  {
                    "type": "box",
                    "class": "paper stat",
                    "children": [
                      { "type": "image", "class": "icon", "src": "asset:img/frisbee.png" },
                      {
                        "type": "box",
                        "class": "col",
                        "children": [
                          { "type": "text", "class": "kicker", "text": "FRISBEE" },
                          { "type": "text", "class": "num small", "text": "{frisbeeRecord}" }
                        ]
                      }
                    ]
                  }
                ]
              }
            ]
          }
        },
        {
          "title": "Bag",
          "child": {
            "type": "box",
            "class": "tab-page",
            "children": [
              {
                "type": "box",
                "class": "paper hero hand",
                "children": [
                  { "type": "image", "class": "corner corner-l", "src": "$corner" },
                  { "type": "image", "class": "corner corner-r", "src": "$cornerR" },
                  { "type": "image", "class": "hand-icon", "src": "$bag.handIcon" },
                  {
                    "type": "box",
                    "class": "col grow",
                    "children": [
                      { "type": "text", "class": "kicker", "text": "IN YOUR HANDS" },
                      { "type": "text", "class": "hand-big", "text": "{bag.handTool}" },
                      { "type": "text", "class": "fine", "text": "Carrying: {bag.handItem}" }
                    ]
                  }
                ]
              },
              {
                "type": "box",
                "class": "fence-title",
                "children": [
                  { "type": "image", "class": "fence", "src": "asset:img/fence-left.png" },
                  { "type": "text", "class": "fence-text", "text": "Tools {bag.toolCount}/8" },
                  { "type": "image", "class": "fence", "src": "asset:img/fence-right.png" }
                ]
              },
              {
                "type": "list",
                "class": "grid-2",
                "items": "$bag.tools",
                "empty": "No tools",
                "template": {
                  "type": "box",
                  "class": "tag",
                  "classIf": { "held": "$held" },
                  "children": [
                    { "type": "image", "class": "icon", "src": "$icon" },
                    { "type": "text", "class": "tag-text", "text": "{name}" }
                  ]
                }
              },
              {
                "type": "box",
                "class": "fence-title",
                "children": [
                  { "type": "image", "class": "fence", "src": "asset:img/fence-left.png" },
                  { "type": "text", "class": "fence-text", "text": "Items {bag.itemCount}/8" },
                  { "type": "image", "class": "fence", "src": "asset:img/fence-right.png" }
                ]
              },
              {
                "type": "list",
                "class": "grid-2",
                "items": "$bag.items",
                "empty": "Nothing packed",
                "template": {
                  "type": "box",
                  "class": "tag",
                  "children": [
                    { "type": "image", "class": "icon", "src": "$icon" },
                    { "type": "text", "class": "tag-text", "text": "{name}" }
                  ]
                }
              }
            ]
          }
        },
        {
          "title": "Love",
          "child": {
            "type": "box",
            "class": "tab-page",
            "children": [
              {
                "type": "box",
                "class": "fence-title",
                "children": [
                  { "type": "image", "class": "fence", "src": "asset:img/fence-left.png" },
                  { "type": "text", "class": "fence-text", "text": "Sweethearts" },
                  { "type": "image", "class": "fence", "src": "asset:img/fence-right.png" }
                ]
              },
              {
                "type": "list",
                "class": "love-list",
                "items": "$loves",
                "template": {
                  "type": "box",
                  "class": "paper love",
                  "children": [
                    { "type": "image", "class": "love-heart", "src": "$heartIcon" },
                    {
                      "type": "box",
                      "class": "col grow",
                      "children": [
                        {
                          "type": "box",
                          "class": "meter-head",
                          "children": [
                            { "type": "text", "class": "love-name", "text": "{name}" },
                            { "type": "text", "class": "heart-chip", "text": "{heart}", "bindStyle": { "background-color": "{heartColor}" } }
                          ]
                        },
                        { "type": "bar", "class": "gauge love-gauge", "value": "$pct", "max": 1, "bindStyle": { "accent-color": "{heartColor}" } },
                        { "type": "text", "class": "fine", "text": "{value} / 65535" }
                      ]
                    }
                  ]
                }
              },
              {
                "type": "box",
                "class": "fence-title",
                "children": [
                  { "type": "image", "class": "fence", "src": "asset:img/fence-left.png" },
                  { "type": "text", "class": "fence-text", "text": "Townsfolk" },
                  { "type": "image", "class": "fence", "src": "asset:img/fence-right.png" }
                ]
              },
              {
                "type": "list",
                "class": "grid-2",
                "items": "$friends",
                "template": {
                  "type": "box",
                  "class": "paper friend",
                  "children": [
                    {
                      "type": "box",
                      "class": "meter-head",
                      "children": [
                        { "type": "text", "class": "friend-name", "text": "{name}" },
                        { "type": "text", "class": "meter-num", "text": "{value}" }
                      ]
                    },
                    { "type": "bar", "class": "gauge friend-gauge", "value": "$pct", "max": 1 }
                  ]
                }
              }
            ]
          }
        },
        {
          "title": "Sprites",
          "child": {
            "type": "box",
            "class": "tab-page",
            "children": [
              {
                "type": "list",
                "class": "love-list",
                "items": "$sprites",
                "template": {
                  "type": "box",
                  "class": "paper sprite",
                  "children": [
                    {
                      "type": "box",
                      "class": "sprite-head",
                      "children": [
                        { "type": "image", "class": "sprite-hat", "src": "$hat" },
                        {
                          "type": "box",
                          "class": "col grow",
                          "children": [
                            {
                              "type": "box",
                              "class": "meter-head",
                              "children": [
                                { "type": "text", "class": "love-name", "text": "{name}" },
                                { "type": "text", "class": "job-chip", "classIf": { "working": "$working" }, "text": "{job}" }
                              ]
                            },
                            { "type": "bar", "class": "gauge friend-gauge", "value": "$friendPct", "max": 1 },
                            { "type": "text", "class": "fine", "text": "Friendship {friendship} / 255" }
                          ]
                        }
                      ]
                    },
                    {
                      "type": "list",
                      "class": "xp-grid",
                      "items": "$xp",
                      "template": {
                        "type": "box",
                        "class": "xp",
                        "children": [
                          { "type": "text", "class": "kicker", "text": "{name}" },
                          { "type": "text", "class": "xp-num", "text": "{value}" },
                          { "type": "bar", "class": "gauge xp-gauge", "value": "$pct", "max": 1 }
                        ]
                      }
                    }
                  ]
                }
              }
            ]
          }
        }
      ]
    }
  ]
}
