         },
         {
          "type": "image",
          "class": "win w-nl",
          "src": "asset:ui/win-76x26.png"
         },
         {
          "type": "image",
          "class": "win w-nt",
          "src": "asset:ui/win-80x26.png"
         },
         {
          "type": "image",
          "class": "win w-nr",
          "src": "asset:ui/win-76x26.png"
         },
         {
          "type": "button",
          "class": "nbtn nbtn-l",
          "onClick": [
           {
            "navigate": "abilities"
           }
          ],
          "children": [
