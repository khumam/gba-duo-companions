            "type": "text",
            "class": "nb nb-l",
            "text": "< Abilities"
           }
          ]
         },
         {
          "type": "text",
          "class": "ntitle",
          "text": "Skills"
         },
         {
          "type": "button",
          "class": "nbtn nbtn-r",
          "onClick": [
