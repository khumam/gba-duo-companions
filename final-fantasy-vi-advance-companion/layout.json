            {
             "type": "text",
             "class": "tab-t",
             "text": "{name}"
            }
           ],
           "classIf": {
            "sel": "$sel"
           }
          }
         },
         {
          "type": "image",
          "class": "win w-esper",
          "src": "asset:ui/win-240x68.png"
         },
         {
          "type": "text",
          "class": "lab esper-l",
          "text": "Esper"
         },
         {
          "type": "text",
          "class": "esper-n",
          "text": "{sel.esper}"
         },
         {
          "type": "list",
          "class": "espers",
          "items": "$espers",
          "template": {
           "type": "text",
           "class": "cell",
           "text": "{name}",
           "classIf": {
            "mine": "$mine",
            "taken": "$taken"
           }
          }
         },
         {
          "type": "image",
          "class": "win w-magic",
          "src": "asset:ui/win-240x88.png"
         },
         {
          "type": "text",
          "class": "lab magic-l",
          "text": "Magic"
         },
         {
          "type": "text",
          "class": "magic-n",
          "text": "{sel.spellCount} learned"
         },
         {
          "type": "list",
          "class": "spells",
          "items": "$spells",
          "template": {
           "type": "text",
           "class": "cell",
           "text": "{name}"
          }
         },
         {
          "type": "image",
          "class": "win w-nl",
          "src": "asset:ui/win-76x26.png"
         },
         {
          "type": "image",
          "class": "win w-nt",
          "src": "asset:ui/win-80x26.png"
         },
         {
          "type": "image",
          "class": "win w-nr",
          "src": "asset:ui/win-76x26.png"
         },
         {
          "type": "button",
          "class": "nbtn nbtn-l",
          "onClick": [
           {
            "navigate": "items"
           }
          ],
          "children": [
           {
            "type": "text",
            "class": "nb nb-l",
            "text": "< Items"
           }
          ]
         },
         {
          "type": "text",
          "class": "ntitle",
          "text": "Abilities"
         },
         {
          "type": "button",
          "class": "nbtn nbtn-r",
          "onClick": [
           {
            "navigate": "skills"
           }
          ],
          "children": [
           {
            "type": "text",
            "class": "nb nb-r",
            "text": "Skills >"
           }
          ]
         }
        ]
       }
      },
      {
       "name": "skills",
       "child": {
        "type": "box",
        "class": "page page-skills",
        "children": [
         {
          "type": "image",
          "class": "win w-head",
          "src": "asset:ui/win-240x20.png"
         },
         {
          "type": "list",
          "class": "tabs",
          "items": "$tabs",
          "template": {
           "type": "button",
           "class": "tab",
           "onClick": [
            {
             "set": {
              "who": "{actor}"
             }
            }
           ],
