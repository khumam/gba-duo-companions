{
 "type": "box",
 "class": "main",
 "children": [
  {
   "type": "box",
   "class": "waiting",
   "children": [
    {
     "type": "box",
     "class": "page page-waiting",
     "children": [
      {
       "type": "image",
       "class": "win w-wait",
       "src": "asset:ui/win-240x208.png"
      },
      {
       "type": "text",
       "class": "wt-1",
       "text": "FINAL FANTASY VI"
      },
      {
       "type": "text",
       "class": "wt-2",
       "text": "ADVANCE"
      },
      {
       "type": "text",
       "class": "wt-3",
       "text": "Load a game to see your party"
      }
     ]
    }
   ],
   "visibleIf": "$waiting"
  },
  {
   "type": "box",
   "class": "ready",
   "children": [
    {
     "type": "pages",
     "class": "stage",
     "initial": "party",
     "pages": [
      {
       "name": "party",
       "child": {
        "type": "box",
        "class": "page page-party",
        "children": [
         {
          "type": "image",
          "class": "win w-party",
          "src": "asset:ui/win-240x156.png"
         },
         {
          "type": "list",
          "class": "members",
          "items": "$party",
          "template": {
           "type": "button",
           "class": "mem",
           "onClick": [
            {
             "set": {
              "who": "{actor}"
             }
            },
            {
             "navigate": "status"
            }
           ],
           "children": [
            {
             "type": "image",
             "class": "mface",
             "src": "$face"
            },
            {
             "type": "text",
             "class": "mname",
             "text": "{name}"
            },
            {
             "type": "text",
             "class": "mclass",
             "text": "{class}"
            },
            {
             "type": "text",
             "class": "lab mlv-l",
             "text": "LV"
            },
            {
             "type": "text",
             "class": "num mlv",
             "text": "{level}"
            },
            {
             "type": "text",
             "class": "lab mhp-l",
             "text": "HP"
            },
            {
             "type": "text",
             "class": "num mhp",
             "text": "{hp}/{maxHp}"
            },
            {
             "type": "text",
             "class": "lab mmp-l",
             "text": "MP"
            },
            {
             "type": "text",
             "class": "num mmp",
             "text": "{mp}/{maxMp}"
            }
           ],
           "classIf": {
            "marked": "$marked"
           }
          }
         },
         {
          "type": "image",
          "class": "win w-info",
          "src": "asset:ui/win-240x22.png"
         },
         {
          "type": "text",
          "class": "lab i-time-l",
          "text": "Time"
         },
         {
          "type": "text",
          "class": "num i-time",
          "text": "{time}"
         },
         {
          "type": "text",
          "class": "lab i-steps-l",
          "text": "Steps"
         },
         {
          "type": "text",
          "class": "num i-steps",
          "text": "{steps}"
         },
         {
          "type": "text",
          "class": "lab i-gil-l",
          "text": "Gil"
         },
         {
          "type": "text",
          "class": "num i-gil",
          "text": "{gil}"
         },
         {
          "type": "image",
          "class": "win w-nl",
          "src": "asset:ui/win-76x26.png"
         },
         {
          "type": "image",
          "class": "win w-nt",
          "src": "asset:ui/win-80x26.png"
         },
         {
          "type": "image",
          "class": "win w-nr",
          "src": "asset:ui/win-76x26.png"
         },
         {
          "type": "button",
          "class": "nbtn nbtn-l",
          "onClick": [
           {
            "navigate": "config"
           }
          ],
          "children": [
           {
            "type": "text",
            "class": "nb nb-l",
            "text": "< Config"
           }
          ]
         },
         {
          "type": "text",
          "class": "ntitle",
          "text": "Party"
         },
         {
          "type": "button",
          "class": "nbtn nbtn-r",
          "onClick": [
           {
            "navigate": "items"
           }
          ],
          "children": [
           {
            "type": "text",
            "class": "nb nb-r",
            "text": "Items >"
           }
          ]
         }
        ]
       }
      },
      {
       "name": "items",
       "child": {
        "type": "box",
        "class": "page page-items",
        "children": [
         {
          "type": "image",
          "class": "win w-head",
          "src": "asset:ui/win-240x20.png"
         },
         {
          "type": "text",
          "class": "head-title",
          "text": "Items"
         },
         {
          "type": "image",
          "class": "win w-list",
          "src": "asset:ui/win-240x134.png"
         },
         {
          "type": "list",
          "class": "itemlist",
          "items": "$items",
          "template": {
           "type": "button",
           "class": "icell",
           "onClick": [
            {
             "set": {
              "item": "{slot}",
              "popup": true
             }
            }
           ],
           "children": [
            {
             "type": "text",
             "class": "iname",
             "text": "{name}"
            },
            {
             "type": "text",
             "class": "iqty",
             "text": ": {qty}"
            }
           ],
           "classIf": {
            "sel": "$sel"
           }
          }
         },
         {
          "type": "text",
          "class": "empty",
          "text": "No items",
          "visibleIf": "$noItems"
         },
         {
          "type": "image",
          "class": "win w-info",
          "src": "asset:ui/win-240x22.png"
         },
         {
          "type": "text",
          "class": "sel-name",
          "text": "{selItem.name}"
         },
         {
          "type": "text",
          "class": "lab sel-qty",
          "text": "x {selItem.qty}",
          "visibleIf": "$items"
         },
         {
          "type": "image",
          "class": "win w-nl",
          "src": "asset:ui/win-76x26.png"
         },
         {
          "type": "image",
          "class": "win w-nt",
          "src": "asset:ui/win-80x26.png"
         },
         {
          "type": "image",
          "class": "win w-nr",
          "src": "asset:ui/win-76x26.png"
         },
         {
          "type": "button",
          "class": "nbtn nbtn-l",
          "onClick": [
           {
            "navigate": "party"
           }
          ],
          "children": [
           {
            "type": "text",
            "class": "nb nb-l",
            "text": "< Party"
           }
          ]
         },
         {
          "type": "text",
          "class": "ntitle",
          "text": "Items"
         },
         {
          "type": "button",
          "class": "nbtn nbtn-r",
          "onClick": [
           {
            "navigate": "abilities"
           }
          ],
          "children": [
           {
            "type": "text",
            "class": "nb nb-r",
            "text": "Abilities >"
           }
          ]
         },
         {
          "type": "box",
          "class": "poplayer",
          "children": [
           {
            "type": "button",
            "class": "dim",
            "onClick": [
             {
              "set": {
               "popup": false
              }
             }
            ],
            "children": []
           },
           {
            "type": "image",
            "class": "win w-pop",
            "src": "asset:ui/win-200x86.png"
           },
           {
            "type": "text",
            "class": "pop-q",
            "text": "{detail.prompt}"
           },
           {
            "type": "text",
            "class": "lab pop-sub",
            "text": "{detail.sub}"
           },
           {
            "type": "list",
            "class": "targets",
            "items": "$tabs",
            "template": {
             "type": "button",
             "class": "tgt",
             "onClick": [
              {
               "call": "useItem",
               "args": [
                "{detail.slot}",
                "{actor}"
               ],
               "set": {
                "popup": false
               }
              }
             ],
             "children": [
              {
               "type": "text",
               "class": "tgt-t",
               "text": "{name}"
              }
             ]
            },
            "visibleIf": "$detail.single"
           },
           {
            "type": "button",
            "class": "pbtn pbtn-yes",
            "onClick": [
             {
              "call": "useItem",
              "args": [
               "{detail.slot}",
               -1
              ],
              "set": {
               "popup": false
              }
             }
            ],
            "children": [
             {
              "type": "text",
              "class": "pbtn-t",
              "text": "Yes"
             }
            ],
            "visibleIf": "$detail.party"
           },
           {
            "type": "button",
            "class": "pbtn pbtn-no",
            "onClick": [
             {
              "set": {
               "popup": false
              }
             }
            ],
            "children": [
             {
              "type": "text",
              "class": "pbtn-t",
              "text": "No"
             }
            ],
            "visibleIf": "$detail.party"
           },
           {
            "type": "button",
            "class": "pbtn pbtn-cancel",
            "onClick": [
             {
              "set": {
               "popup": false
              }
             }
            ],
            "children": [
             {
              "type": "text",
              "class": "pbtn-t",
              "text": "Cancel"
             }
            ],
            "visibleIf": "$detail.single"
           },
           {
            "type": "button",
            "class": "pbtn pbtn-ok",
            "onClick": [
             {
              "set": {
               "popup": false
              }
             }
            ],
            "children": [
             {
              "type": "text",
              "class": "pbtn-t",
              "text": "OK"
             }
            ],
            "visibleIf": "$detail.none"
           }
          ],
          "visibleIf": "$ui.popup"
         }
        ]
       }
      },
      {
       "name": "abilities",
       "child": {
        "type": "box",
        "class": "page page-abilities",
        "children": [
         {
          "type": "image",
          "class": "win w-head",
          "src": "asset:ui/win-240x20.png"
         },
         {
          "type": "list",
