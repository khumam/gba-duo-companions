            {
             "type": "text",
             "class": "tab-t",
             "text": "{name}"
            }
           ],
           "classIf": {
            "sel": "$sel"
           }
          }
         },
         {
          "type": "image",
          "class": "win w-kind",
          "src": "asset:ui/win-240x22.png"
         },
         {
          "type": "list",
          "class": "kinds",
          "items": "$kinds",
          "template": {
           "type": "button",
           "class": "kind",
