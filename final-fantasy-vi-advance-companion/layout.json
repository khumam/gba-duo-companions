             }
            }
           ],
           "children": [
            {
             "type": "text",
             "class": "kind-t",
             "text": "{name}"
            }
           ],
           "classIf": {
            "sel": "$on",
            "off": "$off"
           }
          }
         },
         {
          "type": "image",
          "class": "win w-slist",
          "src": "asset:ui/win-240x134.png"
         },
