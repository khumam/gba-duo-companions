{
  "type": "box",
  "id": "screen",
  "classIf": { "alert": "$lowHealth" },
  "children": [
    {
      "type": "box",
      "class": "waiting",
      "visibleIf": "$waiting",
      "children": [
        { "type": "image", "class": "core", "src": "asset:img/x-core.png" },
        { "type": "text", "class": "waiting-title", "text": "BSL STATION" },
        {
          "type": "box",
          "class": "scan-title",
          "children": [
            { "type": "image", "class": "scan", "src": "asset:img/scan-left.png" },
            { "type": "text", "class": "scan-text", "text": "AWAITING BIO-LINK" },
            { "type": "image", "class": "scan", "src": "asset:img/scan-right.png" }
          ]
        }
      ]
    },
    {
      "type": "tabs",
      "visibleIf": "$ready",
      "tabs": [
        {
          "title": "Status",
          "child": {
            "type": "box",
            "class": "tab-page",
            "children": [
              {
                "type": "box",
                "class": "panel hero",
                "classIf": { "alert": "$lowHealth" },
                "children": [
                  { "type": "image", "class": "bracket bracket-l", "src": "asset:img/bracket-l.png" },
                  { "type": "image", "class": "bracket bracket-r", "src": "asset:img/bracket-r.png" },
                  {
                    "type": "box",
                    "class": "energy-row",
                    "children": [
                      {
                        "type": "box",
                        "class": "col",
                        "children": [
                          { "type": "text", "class": "label", "text": "ENERGY" },
                          { "type": "text", "class": "energy-num", "classIf": { "alert": "$lowHealth" }, "text": "{energy}" }
                        ]
                      },
                      {
                        "type": "box",
                        "class": "col right",
                        "children": [
                          { "type": "text", "class": "alarm", "visibleIf": "$lowHealth", "text": "LOW ENERGY" },
                          { "type": "text", "class": "fine", "text": "{energyRaw} / {maxEnergy}" },
                          { "type": "text", "class": "fine", "text": "{fullTanks} of {tankCount} tanks" }
                        ]
                      }
                    ]
                  },
                  {
                    "type": "list",
                    "class": "tank-row",
                    "items": "$tanks",
                    "template": { "type": "image", "class": "tank", "src": "$src" }
                  },
                  { "type": "bar", "class": "gauge energy-gauge", "classIf": { "alert": "$lowHealth" }, "value": "$energyPct", "max": 1 }
                ]
              },
              {
                "type": "box",
                "class": "grid-2",
                "children": [
                  {
                    "type": "box",
                    "class": "panel stat",
                    "visibleIf": "$hasMissiles",
                    "children": [
                      {
                        "type": "box",
                        "class": "stat-head",
                        "children": [
                          { "type": "image", "class": "icon", "src": "asset:img/icon-missile.png" },
                          { "type": "text", "class": "label grow", "text": "MISSILES" }
                        ]
                      },
                      {
                        "type": "box",
                        "class": "count-row",
                        "children": [
                          { "type": "text", "class": "count missile-num", "text": "{missiles}" },
                          { "type": "text", "class": "fine", "text": "/ {maxMissiles}" }
                        ]
                      },
                      { "type": "bar", "class": "gauge missile-gauge", "value": "$missilePct", "max": 1 }
                    ]
                  },
                  {
                    "type": "box",
                    "class": "panel stat",
                    "visibleIf": "$hasBombs",
                    "children": [
                      {
                        "type": "box",
                        "class": "stat-head",
                        "children": [
                          { "type": "image", "class": "icon", "src": "asset:img/icon-powerbomb.png" },
                          { "type": "text", "class": "label grow", "text": "POWER BOMBS" }
                        ]
                      },
                      {
                        "type": "box",
                        "class": "count-row",
                        "children": [
                          { "type": "text", "class": "count bomb-num", "text": "{powerBombs}" },
                          { "type": "text", "class": "fine", "text": "/ {maxPowerBombs}" }
                        ]
                      },
                      { "type": "bar", "class": "gauge bomb-gauge", "value": "$bombPct", "max": 1 }
                    ]
                  }
                ]
              },
              {
                "type": "box",
                "class": "panel location",
                "children": [
                  { "type": "image", "class": "emblem", "src": "$sectorEmblem" },
                  {
                    "type": "box",
                    "class": "col grow",
                    "children": [
                      { "type": "text", "class": "label", "text": "LOCATION" },
                      { "type": "text", "class": "place", "text": "{sector} · {sectorCode}" },
                      { "type": "text", "class": "fine", "text": "Room {room}" }
                    ]
                  },
                  { "type": "image", "class": "icon-here", "src": "asset:img/icon-here.png" }
                ]
              },
              {
                "type": "box",
                "class": "grid-2",
                "children": [
                  {
                    "type": "box",
                    "class": "panel stat",
                    "children": [
                      {
                        "type": "box",
                        "class": "stat-head",
                        "children": [
                          { "type": "image", "class": "icon", "src": "asset:img/icon-lock.png" },
                          { "type": "text", "class": "label grow", "text": "SECURITY" }
                        ]
                      },
                      { "type": "text", "class": "value", "text": "{securityText}" },
                      {
                        "type": "list",
                        "class": "pip-row",
                        "items": "$security",
                        "template": { "type": "box", "class": "pip", "classIf": { "open": "$open" }, "bindStyle": { "background-color": "{color}" }, "children": [] }
                      }
                    ]
                  },
                  {
                    "type": "box",
                    "class": "panel stat",
                    "children": [
                      {
                        "type": "box",
                        "class": "stat-head",
                        "children": [
                          { "type": "image", "class": "icon", "src": "asset:img/icon-timer.png" },
                          { "type": "text", "class": "label grow", "text": "MISSION TIME" }
                        ]
                      },
                      { "type": "text", "class": "value time", "text": "{time}" }
                    ]
                  }
                ]
              }
            ]
          }
        },
        {
          "title": "Abilities",
          "child": {
            "type": "box",
            "class": "tab-page",
            "children": [
              {
                "type": "box",
                "class": "panel hero slim",
                "children": [
                  { "type": "image", "class": "bracket bracket-l", "src": "asset:img/bracket-l.png" },
                  { "type": "image", "class": "bracket bracket-r", "src": "asset:img/bracket-r.png" },
                  {
                    "type": "box",
                    "class": "energy-row",
                    "children": [
                      { "type": "text", "class": "title", "text": "ABILITIES" },
                      { "type": "text", "class": "title-count", "text": "{abilityCount}/{abilityTotal}" }
                    ]
                  }
                ]
              },
              {
                "type": "list",
                "class": "groups",
                "items": "$abilities",
                "template": {
                  "type": "box",
                  "class": "panel group",
                  "children": [
                    {
                      "type": "box",
                      "class": "scan-title",
                      "children": [
                        { "type": "image", "class": "scan", "src": "asset:img/scan-left.png" },
                        { "type": "text", "class": "scan-text", "text": "{title}" },
                        { "type": "image", "class": "scan", "src": "asset:img/scan-right.png" }
                      ]
                    },
                    {
                      "type": "list",
                      "class": "ability-grid",
                      "items": "$items",
                      "template": {
                        "type": "box",
                        "class": "ability",
                        "classIf": { "owned": "$owned" },
                        "children": [
                          { "type": "image", "class": "ability-img", "src": "$icon" },
                          { "type": "text", "class": "ability-name", "text": "{name}" }
                        ]
                      }
                    }
                  ]
                }
              }
            ]
          }
        },
        {
          "title": "Sectors",
          "child": {
            "type": "box",
            "class": "tab-page",
            "children": [
              {
                "type": "list",
                "class": "sector-list",
                "items": "$sectors",
                "template": {
                  "type": "box",
                  "class": "panel sector",
                  "classIf": { "here": "$here" },
                  "children": [
                    { "type": "image", "class": "emblem", "src": "$emblem" },
                    {
                      "type": "box",
                      "class": "col grow",
                      "children": [
                        {
                          "type": "box",
                          "class": "sector-head",
                          "children": [
                            { "type": "text", "class": "sector-code", "text": "{code}" },
                            { "type": "text", "class": "fine grow", "text": "{name}" },
                            { "type": "image", "class": "icon-small", "visibleIf": "$here", "src": "asset:img/icon-here.png" },
                            { "type": "image", "class": "icon-small dim", "classIf": { "on": "$mapped" }, "src": "asset:img/icon-map.png" },
                            { "type": "text", "class": "pct", "text": "{percent}%" }
                          ]
                        },
                        { "type": "bar", "class": "gauge sector-gauge", "value": "$pct", "max": 1 }
                      ]
                    }
                  ]
                }
              }
            ]
          }
        }
      ]
    }
  ]
}
