{
  "type": "box",
  "class": "screen",
  "children": [
    {
      "type": "box",
      "class": "waiting",
      "children": [
        {
          "type": "list",
          "class": "wait",
          "items": "$wait",
          "template": {
            "type": "list",
            "class": "line",
            "items": "$g",
            "template": {
              "type": "image",
              "class": "g",
              "src": "$src"
            }
          }
        }
      ],
      "visibleIf": "$waiting"
    },
    {
      "type": "box",
      "class": "shell",
      "children": [
        {
          "type": "pages",
          "pages": [
            {
              "name": "status",
              "child": {
                "type": "box",
                "class": "page page-status",
                "children": [
                  {
                    "type": "box",
                    "class": "stage",
                    "children": [
                      {
                        "type": "box",
                        "class": "hdr",
                        "children": [
                          {
                            "type": "image",
                            "class": "header",
                            "src": "$art.header"
                          },
                          {
                            "type": "list",
                            "class": "num n-energy-now",
                            "items": "$energyNow",
                            "template": {
                              "type": "image",
                              "class": "g",
                              "src": "$src"
                            }
                          },
                          {
                            "type": "list",
                            "class": "num n-energy-max",
                            "items": "$energyMax",
                            "template": {
                              "type": "image",
                              "class": "g",
                              "src": "$src"
                            }
                          },
                          {
                            "type": "list",
                            "class": "num n-missile-now",
                            "items": "$missileNow",
                            "template": {
                              "type": "image",
                              "class": "g",
                              "src": "$src"
                            }
                          },
                          {
                            "type": "list",
                            "class": "num n-missile-max",
                            "items": "$missileMax",
                            "template": {
                              "type": "image",
                              "class": "g",
                              "src": "$src"
                            }
                          },
                          {
                            "type": "list",
                            "class": "num n-bomb-now",
                            "items": "$bombNow",
                            "template": {
                              "type": "image",
                              "class": "g",
                              "src": "$src"
                            }
                          },
                          {
                            "type": "list",
                            "class": "num n-bomb-max",
                            "items": "$bombMax",
                            "template": {
                              "type": "image",
                              "class": "g",
                              "src": "$src"
                            }
                          }
                        ]
                      },
                      {
                        "type": "box",
                        "class": "body",
                        "children": [
                          {
                            "type": "image",
                            "class": "frame",
                            "src": "$art.frameL"
                          },
                          {
                            "type": "list",
                            "class": "side side-left",
                            "items": "$left",
                            "template": {
                              "type": "list",
                              "class": "line",
                              "items": "$g",
                              "template": {
                                "type": "image",
                                "class": "g",
                                "src": "$src"
                              }
                            }
                          },
                          {
                            "type": "image",
                            "class": "center",
                            "src": "$art.center"
                          },
                          {
                            "type": "list",
                            "class": "side side-right",
                            "items": "$right",
                            "template": {
                              "type": "list",
                              "class": "line",
                              "items": "$g",
                              "template": {
                                "type": "image",
                                "class": "g",
                                "src": "$src"
                              }
                            }
                          },
                          {
                            "type": "image",
                            "class": "frame",
                            "src": "$art.frameR"
                          }
                        ]
                      },
                      {
                        "type": "box",
                        "class": "info",
                        "children": [
                          {
                            "type": "image",
                            "class": "frame2",
                            "src": "$art.sideL"
                          },
                          {
                            "type": "list",
                            "class": "info-text",
                            "items": "$hatchRows",
                            "template": {
                              "type": "list",
                              "class": "line",
                              "items": "$g",
                              "template": {
                                "type": "image",
                                "class": "g",
                                "src": "$src"
                              }
                            }
                          },
                          {
                            "type": "image",
                            "class": "frame2",
                            "src": "$art.sideR"
                          }
                        ]
                      },
                      {
                        "type": "image",
                        "class": "botbar",
                        "src": "$art.botbar"
                      }
                    ]
                  },
                  {
                    "type": "box",
                    "class": "nav",
                    "children": [
                      {
                        "type": "button",
                        "class": "tab on",
                        "onClick": [
                          {
                            "navigate": "status"
                          }
                        ],
                        "children": [
                          {
                            "type": "list",
                            "class": "line",
                            "items": "$nav.status",
                            "template": {
                              "type": "image",
                              "class": "g",
                              "src": "$src"
                            }
                          }
                        ]
                      },
                      {
                        "type": "button",
                        "class": "tab",
                        "onClick": [
                          {
                            "navigate": "arms"
                          }
                        ],
                        "children": [
                          {
                            "type": "list",
                            "class": "line",
                            "items": "$nav.arms",
                            "template": {
                              "type": "image",
                              "class": "g",
                              "src": "$src"
                            }
                          }
                        ]
                      },
                      {
                        "type": "button",
                        "class": "tab",
                        "onClick": [
                          {
                            "navigate": "map"
                          }
                        ],
                        "children": [
                          {
                            "type": "list",
                            "class": "line",
                            "items": "$nav.map",
                            "template": {
                              "type": "image",
                              "class": "g",
                              "src": "$src"
                            }
                          }
                        ]
                      }
                    ]
                  }
                ]
              }
            },
            {
              "name": "arms",
              "child": {
                "type": "box",
                "class": "page page-arms",
                "children": [
                  {
                    "type": "box",
                    "class": "stage",
                    "children": [
                      {
                        "type": "box",
                        "class": "hdr",
                        "children": [
                          {
                            "type": "image",
                            "class": "header",
                            "src": "$art.header"
                          },
                          {
                            "type": "list",
                            "class": "num n-energy-now",
                            "items": "$energyNow",
                            "template": {
                              "type": "image",
                              "class": "g",
                              "src": "$src"
                            }
                          },
                          {
                            "type": "list",
                            "class": "num n-energy-max",
                            "items": "$energyMax",
                            "template": {
                              "type": "image",
                              "class": "g",
                              "src": "$src"
                            }
                          },
                          {
                            "type": "list",
                            "class": "num n-missile-now",
                            "items": "$missileNow",
                            "template": {
                              "type": "image",
                              "class": "g",
                              "src": "$src"
                            }
                          },
                          {
                            "type": "list",
                            "class": "num n-missile-max",
                            "items": "$missileMax",
                            "template": {
                              "type": "image",
                              "class": "g",
                              "src": "$src"
                            }
                          },
                          {
                            "type": "list",
                            "class": "num n-bomb-now",
                            "items": "$bombNow",
                            "template": {
                              "type": "image",
                              "class": "g",
                              "src": "$src"
                            }
                          },
                          {
                            "type": "list",
                            "class": "num n-bomb-max",
                            "items": "$bombMax",
                            "template": {
                              "type": "image",
                              "class": "g",
                              "src": "$src"
                            }
                          }
                        ]
                      },
                      {
                        "type": "box",
                        "class": "arms",
                        "children": [
                          {
                            "type": "box",
                            "class": "win w-beam",
                            "children": [
                              {
                                "type": "image",
                                "class": "w-title",
                                "src": "$windows.beam.title"
                              },
                              {
                                "type": "list",
                                "class": "w-rows",
                                "items": "$windows.beam.rows",
                                "template": {
                                  "type": "image",
                                  "class": "w-row",
                                  "src": "$src",
                                  "classIf": {
                                    "owned": "$owned"
                                  }
                                }
                              },
                              {
                                "type": "image",
                                "class": "w-foot",
                                "src": "$windows.beam.footer"
                              }
                            ]
                          },
                          {
                            "type": "box",
                            "class": "win w-missile",
                            "children": [
                              {
                                "type": "image",
                                "class": "w-title",
                                "src": "$windows.missile.title"
                              },
                              {
                                "type": "list",
                                "class": "w-rows",
                                "items": "$windows.missile.rows",
                                "template": {
                                  "type": "image",
                                  "class": "w-row",
                                  "src": "$src",
                                  "classIf": {
                                    "owned": "$owned"
                                  }
                                }
                              },
                              {
                                "type": "image",
                                "class": "w-foot",
                                "src": "$windows.missile.footer"
                              }
                            ]
                          },
                          {
                            "type": "box",
                            "class": "win w-suit",
                            "children": [
                              {
                                "type": "image",
                                "class": "w-title",
                                "src": "$windows.suit.title"
                              },
                              {
                                "type": "list",
                                "class": "w-rows",
                                "items": "$windows.suit.rows",
                                "template": {
                                  "type": "image",
                                  "class": "w-row",
                                  "src": "$src",
                                  "classIf": {
                                    "owned": "$owned"
                                  }
                                }
                              },
                              {
                                "type": "image",
                                "class": "w-foot",
                                "src": "$windows.suit.footer"
                              }
                            ]
                          },
                          {
                            "type": "box",
                            "class": "win w-misc",
                            "children": [
                              {
                                "type": "image",
                                "class": "w-title",
                                "src": "$windows.misc.title"
                              },
                              {
                                "type": "list",
                                "class": "w-rows",
                                "items": "$windows.misc.rows",
                                "template": {
                                  "type": "image",
                                  "class": "w-row",
                                  "src": "$src",
                                  "classIf": {
                                    "owned": "$owned"
                                  }
                                }
                              },
                              {
                                "type": "image",
                                "class": "w-foot",
                                "src": "$windows.misc.footer"
                              }
                            ]
                          },
                          {
                            "type": "box",
                            "class": "win w-bomb",
                            "children": [
                              {
                                "type": "image",
                                "class": "w-title",
                                "src": "$windows.bomb.title"
                              },
                              {
                                "type": "list",
                                "class": "w-rows",
                                "items": "$windows.bomb.rows",
                                "template": {
                                  "type": "image",
                                  "class": "w-row",
                                  "src": "$src",
                                  "classIf": {
                                    "owned": "$owned"
                                  }
                                }
                              },
                              {
                                "type": "image",
                                "class": "w-foot",
                                "src": "$windows.bomb.footer"
                              }
                            ]
                          }
                        ]
                      },
                      {
                        "type": "list",
                        "class": "arms-info",
                        "items": "$armsInfo",
                        "template": {
                          "type": "list",
                          "class": "line",
                          "items": "$g",
                          "template": {
                            "type": "image",
                            "class": "g",
                            "src": "$src"
                          }
                        }
                      },
                      {
                        "type": "image",
                        "class": "botbar",
                        "src": "$art.botbar"
                      }
                    ]
                  },
                  {
                    "type": "box",
                    "class": "nav",
                    "children": [
                      {
                        "type": "button",
                        "class": "tab",
                        "onClick": [
                          {
                            "navigate": "status"
                          }
                        ],
                        "children": [
                          {
                            "type": "list",
                            "class": "line",
                            "items": "$nav.status",
                            "template": {
                              "type": "image",
                              "class": "g",
                              "src": "$src"
                            }
                          }
                        ]
                      },
                      {
                        "type": "button",
                        "class": "tab on",
                        "onClick": [
                          {
                            "navigate": "arms"
                          }
                        ],
                        "children": [
                          {
                            "type": "list",
                            "class": "line",
                            "items": "$nav.arms",
                            "template": {
                              "type": "image",
                              "class": "g",
                              "src": "$src"
                            }
                          }
                        ]
                      },
                      {
                        "type": "button",
                        "class": "tab",
                        "onClick": [
                          {
                            "navigate": "map"
                          }
                        ],
                        "children": [
                          {
                            "type": "list",
                            "class": "line",
                            "items": "$nav.map",
                            "template": {
                              "type": "image",
                              "class": "g",
                              "src": "$src"
                            }
                          }
                        ]
                      }
                    ]
                  }
                ]
              }
            },
            {
              "name": "map",
              "child": {
                "type": "box",
                "class": "page page-map",
                "children": [
                  {
                    "type": "box",
                    "class": "stage",
                    "children": [
                      {
                        "type": "box",
                        "class": "map",
                        "children": [
                          {
                            "type": "image",
                            "class": "outline",
                            "src": "$art.outline"
                          },
                          {
                            "type": "image",
                            "class": "minimap",
                            "src": "$art.map"
                          },
                          {
                            "type": "box",
                            "class": "marker",
                            "children": [],
                            "bindStyle": {
                              "--mx": "{markCol}px",
                              "--my": "{markRow}px"
                            }
                          },
                          {
                            "type": "list",
                            "class": "plate",
                            "items": "$sectorName",
                            "template": {
                              "type": "image",
                              "class": "g",
                              "src": "$src"
                            }
                          }
                        ]
                      },
                      {
                        "type": "list",
                        "class": "map-info",
                        "items": "$sectorRows",
                        "template": {
                          "type": "list",
                          "class": "line",
                          "items": "$g",
                          "template": {
                            "type": "image",
                            "class": "g",
                            "src": "$src"
                          }
                        }
                      }
                    ]
                  },
                  {
                    "type": "box",
                    "class": "nav",
                    "children": [
                      {
                        "type": "button",
                        "class": "tab",
                        "onClick": [
                          {
                            "navigate": "status"
                          }
                        ],
                        "children": [
                          {
                            "type": "list",
                            "class": "line",
                            "items": "$nav.status",
                            "template": {
                              "type": "image",
                              "class": "g",
                              "src": "$src"
                            }
                          }
                        ]
                      },
                      {
                        "type": "button",
                        "class": "tab",
                        "onClick": [
                          {
                            "navigate": "arms"
                          }
                        ],
                        "children": [
                          {
                            "type": "list",
                            "class": "line",
                            "items": "$nav.arms",
                            "template": {
                              "type": "image",
                              "class": "g",
                              "src": "$src"
                            }
                          }
                        ]
                      },
                      {
                        "type": "button",
                        "class": "tab on",
                        "onClick": [
                          {
                            "navigate": "map"
                          }
                        ],
                        "children": [
                          {
                            "type": "list",
                            "class": "line",
                            "items": "$nav.map",
                            "template": {
                              "type": "image",
                              "class": "g",
                              "src": "$src"
                            }
                          }
                        ]
                      }
                    ]
                  }
                ]
              }
            }
          ]
        }
      ],
      "visibleIf": "$ready"
    }
  ],
  "id": "screen",
  "classIf": {
    "alert": "$lowHealth"
  }
}
